generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  password     String
  name         String
  role         String     @default("admin")
  failedLogins Int        @default(0) @map("failed_logins")
  lockedUntil  DateTime?  @map("locked_until")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  auditLogs    AuditLog[]

  @@map("users")
}

model Client {
  id                Int              @id @default(autoincrement())
  name              String
  email             String           @unique
  phone             String?
  company           String?
  rut               String?
  address           String?
  color             String?
  contactName       String?          @map("contact_name")
  contactPhone      String?          @map("contact_phone")
  active            Boolean          @default(true)
  deletedAt         DateTime?        @map("deleted_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  ads               Ad[]
  referralsGiven    Referral[]       @relation("ReferralReferrer")
  referralsReceived Referral[]       @relation("ReferralReferred")
  portalUser        ClientUser?

  @@map("clients")
}

// Acceso de una empresa (Client) al portal de estadísticas. Uno por empresa.
// Tabla y sesión aparte de los usuarios del panel (User): una cuenta de
// portal nunca puede usar rutas del panel. Contraseña y tokens se guardan
// sólo como hash.
model ClientUser {
  id              Int       @id @default(autoincrement())
  clientId        Int       @unique @map("client_id")
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  active          Boolean   @default(true)
  // Se incrementa para cerrar todas las sesiones abiertas al instante.
  sessionVersion  Int       @default(0) @map("session_version")
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil     DateTime? @map("locked_until")
  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  invitedAt       DateTime? @map("invited_at")
  resetTokenHash  String?   @unique @map("reset_token_hash")
  resetExpiresAt  DateTime? @map("reset_expires_at")
  lastLoginAt     DateTime? @map("last_login_at")
  lastLoginIp     String?   @map("last_login_ip")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("client_users")
}

enum AdType {
  video
  image
}

model Ad {
  id             Int          @id @default(autoincrement())
  // Empresa dueña del anuncio. Un anuncio es de una sola empresa; las
  // métricas del portal salen de acá. Nullable sólo por los anuncios viejos.
  clientId       Int?         @map("client_id")
  client         Client?      @relation(fields: [clientId], references: [id])
  name           String
  // Nombre que ve la empresa en su portal (el name suele ser el archivo).
  publicName     String?      @map("public_name")
  // Lo subió la empresa desde su portal (entra pendiente y sin playlists).
  uploadedByClient Boolean    @default(false) @map("uploaded_by_client")
  type           AdType
  fileUrl        String       @map("file_url")
  thumbnailUrl   String?      @map("thumbnail_url")
  filename       String
  // Peso del archivo en bytes (para mostrar cuánto pesa cada campaña). Se
  // completa al subir; los anuncios viejos se rellenan con un HEAD a R2.
  fileSize       Int?         @map("file_size")
  durationS      Int          @map("duration_s")
  active         Boolean      @default(true)
  approvalStatus String       @default("approved") @map("approval_status")
  priority       Int          @default(0)
  targetUrl      String?      @map("target_url")
  startsAt       DateTime?    @map("starts_at")
  endsAt         DateTime?    @map("ends_at")
  tags           String[]     @default([])
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  playlistAds    PlaylistAd[]
  metrics        Metric[]
  abTestsA       AbTest[]     @relation("AbTestAdA")
  abTestsB       AbTest[]     @relation("AbTestAdB")

  @@index([clientId])
  @@map("ads")
}

model Playlist {
  id           Int               @id @default(autoincrement())
  name         String
  // Pausada: las tablets que la tienen muestran el institucional.
  active       Boolean           @default(true)
  version      Int               @default(1)
  contentHash  String?           @map("content_hash")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  playlistAds  PlaylistAd[]
  tablets      Tablet[]
  tabletGroups TabletGroup[]
  versions     PlaylistVersion[]

  @@map("playlists")
}

model PlaylistVersion {
  id         Int      @id @default(autoincrement())
  playlistId Int      @map("playlist_id")
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  version    Int
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("playlist_versions")
}

model PlaylistAd {
  id         Int      @id @default(autoincrement())
  playlistId Int      @map("playlist_id")
  playlist   Playlist @relation(fields: [playlistId], references: [id])
  adId       Int      @map("ad_id")
  ad         Ad       @relation(fields: [adId], references: [id])
  order      Int
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("playlist_ads")
}

enum TabletStatus {
  online
  offline
  syncing
}

model TabletGroup {
  id         Int       @id @default(autoincrement())
  name       String
  playlistId Int?      @map("playlist_id")
  playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  tablets    Tablet[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("tablet_groups")
}

model Tablet {
  id               Int             @id @default(autoincrement())
  deviceId         String          @unique @map("device_id")
  token            String          @unique
  name             String
  zone             String?
  timezone         String?         @default("America/Montevideo")
  playlistId       Int?            @map("playlist_id")
  playlist         Playlist?       @relation(fields: [playlistId], references: [id])
  groupId          Int?            @map("group_id")
  group            TabletGroup?    @relation(fields: [groupId], references: [id])
  scheduleAt       DateTime?       @map("schedule_at")
  lastSync         DateTime?       @map("last_sync")
  status           TabletStatus    @default(offline)
  notes            String?
  maintenanceUntil DateTime?       @map("maintenance_until")
  driverName       String?         @map("driver_name")
  licensePlate     String?         @map("license_plate")
  spotPrice        Float?          @map("spot_price")
  batteryLevel     Int?            @map("battery_level")
  temperatureC     Float?          @map("temperature_c")
  appVersion       String?         @map("app_version")
  lastIp           String?         @map("last_ip")
  osVersion        String?         @map("os_version")
  deviceModel      String?         @map("device_model")
  brightness       Int?
  brightnessAuto   Boolean?        @map("brightness_auto")
  serial           String?
  playerOk         Boolean?        @map("player_ok")
  onFallback       Boolean?        @map("on_fallback")
  lux              Float?          @map("lux")
  lightSensor      Boolean?        @map("light_sensor")
  lastAdAgoS       Int?            @map("last_ad_ago_s")
  lastScreenshot   String?         @map("last_screenshot")
  lastScreenshotAt DateTime?       @map("last_screenshot_at")
  lastLat          Float?          @map("last_lat")
  lastLng          Float?          @map("last_lng")
  manualStatus     String          @default("activa") @map("manual_status")
  fcmToken         String?         @map("fcm_token")
  rotated180       Boolean         @default(false) @map("rotated_180")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  metrics          Metric[]
  errorLogs        ErrorLog[]
  syncLogs         SyncLog[]
  messages         TabletMessage[]
  driverPoints     DriverPoints?
  abGroup          String?         @map("ab_group")

  @@map("tablets")
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  tabletId  Int      @map("tablet_id")
  tablet    Tablet   @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  version   Int      @default(0)
  success   Boolean  @default(true)
  errorMsg  String?  @map("error_msg")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tabletId])
  @@map("sync_logs")
}

model TabletMessage {
  id        Int      @id @default(autoincrement())
  tabletId  Int      @map("tablet_id")
  tablet    Tablet   @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  message   String
  shown     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tablet_messages")
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model Metric {
  id              Int      @id @default(autoincrement())
  tabletId        Int      @map("tablet_id")
  tablet          Tablet   @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  adId            Int      @map("ad_id")
  ad              Ad       @relation(fields: [adId], references: [id])
  playedAt        DateTime @map("played_at")
  durationPlayedS Int      @map("duration_played_s")
  completed       Boolean
  error           Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tabletId])
  @@index([playedAt])
  @@index([adId, playedAt], map: "metrics_ad_id_idx")
  // Clave natural: un reenvío del mismo lote no duplica filas. Declarado acá
  // para que un `prisma db push` nunca lo borre.
  @@unique([tabletId, adId, playedAt], map: "metrics_natural_key")
  @@map("metrics")
}

model ErrorLog {
  id         Int      @id @default(autoincrement())
  tabletId   Int      @map("tablet_id")
  tablet     Tablet   @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  errorType  String   @map("error_type")
  message    String
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("error_logs")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?     @map("entity_id")
  details   String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminNote {
  id         Int      @id @default(autoincrement())
  body       String
  authorName String   @default("Admin") @map("author_name")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("admin_notes")
}

model Favorite {
  id         Int      @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([entityType, entityId])
  @@map("favorites")
}

model Reminder {
  id        Int       @id @default(autoincrement())
  title     String
  body      String?
  dueAt     DateTime? @map("due_at")
  done      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("reminders")
}

model AbTest {
  id        Int      @id @default(autoincrement())
  name      String
  adAId     Int      @map("ad_a_id")
  adBId     Int      @map("ad_b_id")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  adA       Ad       @relation("AbTestAdA", fields: [adAId], references: [id])
  adB       Ad       @relation("AbTestAdB", fields: [adBId], references: [id])

  @@map("ab_tests")
}

model Referral {
  id         Int      @id @default(autoincrement())
  referrerId Int      @map("referrer_id")
  referredId Int?     @map("referred_id")
  code       String   @unique
  used       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  referrer   Client   @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referred   Client?  @relation("ReferralReferred", fields: [referredId], references: [id])

  @@map("referrals")
}

model DriverPoints {
  id             Int      @id @default(autoincrement())
  tabletId       Int      @unique @map("tablet_id")
  points         Int      @default(0)
  syncs30d       Int      @default(0) @map("syncs_30d")
  lastCalculated DateTime @default(now()) @map("last_calculated")
  tablet         Tablet   @relation(fields: [tabletId], references: [id])

  @@map("driver_points")
}

model Zone {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  polygon     Json     @default("[]")
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("zones")
}

model ApiKey {
  id        Int       @id @default(autoincrement())
  name      String
  key       String    @unique
  active    Boolean   @default(true)
  lastUsed  DateTime? @map("last_used")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}
